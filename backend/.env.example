# Binance API Keys - Paper Trading (Testnet)
BINANCE_API_KEY=your_testnet_api_key_here
BINANCE_SECRET_KEY=your_testnet_secret_key_here

# Telegram Notifications (Optional)
# Get bot token from @BotFather, chat ID from @userinfobot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Multi-Symbol Trading (Set to true to trade top 20 pairs instead of just one)
TRADE_ALL_SYMBOLS=false
DEFAULT_MULTI_SYMBOL_COUNT=10
FORCE_INCLUDE_SYMBOLS=BTCUSDT

# Adaptive ML Trading Settings
# Minimum confidence required for trades (75% recommended for quality)
MIN_SIGNAL_CONFIDENCE_SINGLE=75
MIN_SIGNAL_CONFIDENCE_MULTI=75

# Enable exchange-level stop loss orders (true/false)
ENABLE_EXCHANGE_STOP_LOSS=false

# Strategy Mode
# rule = EMA/RSI/Volume logic
# ml = premium model from trainer.py
STRATEGY_MODE=ml
ML_MODEL_PATH=ml_models

# Trading Configuration
TRADING_SYMBOL=BTCUSDT
RISK_LEVEL=medium
MAX_POSITIONS=3
LEVERAGE=5
STOP_LOSS_PERCENT=2.0
TAKE_PROFIT_PERCENT=4.0
TRADE_PERCENTAGE=30

# Server Configuration
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
DEBUG=True
